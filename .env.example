# ==========================================
# FREE API KEYS - How to get them:
# ==========================================

# 1. OPENROUTER (You already have this!)
#    Website: https://openrouter.ai
#    Sign up -> Get API Key -> Choose "Meta Llama 3.8B Instruct" (FREE)
LLM_API_KEY=YOUR LLM_API_KEY

# 2. HUGGINGFACE (FREE - No key needed for local embeddings!)
#    But get one for rate limits: https://huggingface.co/settings/tokens
#    Free tier: Unlimited local usage, 1,000 API calls/month
HUGGINGFACE_API_KEY=YOUR_EMBEDDINGS_MODEL_API_KEY

# ==========================================
# DATABASE & CACHE (Docker provides these FREE)
# ==========================================
DATABASE_URL=postgresql://raguser:ragpassword@postgres:5432/ragdb
REDIS_URL=redis://redis:6379/0

# ==========================================
# CHROMA VECTOR DB (FREE - Local, no API key)
# ==========================================
CHROMA_PERSIST_DIR=./chroma_db

# ==========================================
# LLM CONFIGURATION
# ==========================================
# Using OpenRouter FREE tier - Meta Llama 3.8B Instruct
# Free limit: 20 requests/minute, 200 requests/day
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ==========================================
# EMBEDDINGS (FREE - HuggingFace Local)
# ==========================================
# Using sentence-transformers/all-MiniLM-L6-v2 (FREE, runs locally)
# No API calls needed! Downloads once, runs forever.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==========================================
# RERANKER (FREE - HuggingFace Local)
# ==========================================
# Using BAAI/bge-reranker-base (FREE, runs locally)
RERANKER_MODEL=BAAI/bge-reranker-base

# ==========================================
# RAG CONFIGURATION
# ==========================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
SIMILARITY_THRESHOLD=0.1
MAX_RETRIES=1

# ==========================================
# APPLICATION
# ==========================================
APP_NAME=Advanced RAG System
DEBUG=false
LOG_LEVEL=INFO
